# Copy to robot/normacore/.env (git-ignored) after identifying the buses with examples/01_list_buses.py.
# Each ElRobot arm is one servo bus, named by its controller board's serial number.

# The arm we command. Required when more than one bus is connected.
FOLLOWER_SERIAL=
# The arm you move by hand. elrobot.py refuses to command it.
LEADER_SERIAL=
# Where Station runs. localhost when it runs on this laptop.
STATION_HOST=localhost
